{
    // Theme 
    "workbench.colorTheme": "Catppuccin Mocha", 
    "workbench.iconTheme": "vscode-icons",

    // Font (muy importante para el look)
    "editor.fontFamily": "JetBrainsMono Nerd Font Mono, Fira Code, Operator Mono, Menlo, Monaco, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 2.1,

    // Cursor & caret
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",

    // Better contrast / readability
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,

    // UI polish
    "editor.minimap.enabled": false,
    "workbench.activityBar.location": "default",
    "explorer.compactFolders": false,
    "window.menuBarVisibility": "compact",
    "window.zoomLevel": 0.5,

    // Terminal look
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.lineHeight": 1.3,

    // Glow vibe 
    "workbench.colorCustomizations": {
        "editor.selectionBackground": "#4D21FC55",
        "editorCursor.foreground": "#FAD000"
    },

    // Others
    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "editor.accessibilitySupport": "off",

    // Screencast Mode 
    "screencastMode.keyboardOptions": { 
        "showKeys": false, 
        "showCommandGroups": true 
    },
    "screencastMode.mouseIndicatorColor": "#001EFF",
    "screencastMode.mouseIndicatorSize": 30,
    "chat.viewSessions.orientation": "stacked",
    "accessibility.voice.speechLanguage": "es-ES",
}